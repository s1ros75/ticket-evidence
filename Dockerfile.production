# 本番（公開するデモ）用のイメージ
# - Reactをビルドした画面を、Railsの public/ に入れて一緒に配信する（画面とAPIを同じオリジンにする。docs/design.md）
# - 開発には使わない。開発は docker-compose.yml（backend/Dockerfile、frontend/Dockerfile）を使う
#
# ローカルで確かめるとき:
#   docker build -f Dockerfile.production -t ticket-evidence .

# ---------- 画面のビルド ----------
FROM node:20-slim AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# 1 のとき、画面の上にデモ環境であることを表示する
ARG VITE_DEMO_MODE=0
ENV VITE_DEMO_MODE=$VITE_DEMO_MODE
RUN npm run build

# ---------- Rails の共通部分 ----------
FROM ruby:3.3.10-slim AS base
WORKDIR /rails
ENV RAILS_ENV=production \
    BUNDLE_DEPLOYMENT=1 \
    BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_WITHOUT=development:test
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y libpq5 libyaml-0-2 && \
    rm -rf /var/lib/apt/lists/*

# ---------- gem のインストール ----------
FROM base AS build
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential git libpq-dev libyaml-dev pkg-config && \
    rm -rf /var/lib/apt/lists/*
COPY backend/Gemfile backend/Gemfile.lock ./
RUN bundle install && \
    rm -rf ~/.bundle "${BUNDLE_PATH}"/ruby/*/cache
COPY backend/ ./
RUN bundle exec bootsnap precompile app/ lib/

# ---------- 実行用のイメージ ----------
FROM base
COPY --from=build /usr/local/bundle /usr/local/bundle
COPY --from=build /rails /rails
COPY --from=frontend /frontend/dist /rails/public

RUN mkdir -p log tmp/pids tmp/cache && \
    useradd rails --create-home --shell /bin/bash && \
    chown -R rails:rails log tmp db
USER rails

EXPOSE 3000
# マイグレーションと、デモのデータの用意をしてから起動する（backend/bin/start）
CMD ["bin/start"]
